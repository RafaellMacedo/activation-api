{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/provider/v1/activate",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.productCode == 'INVALID')]"
      }
    ]
  },
  "response": {
    "status": 400,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "message": "Invalid product code"
    }
  }
}